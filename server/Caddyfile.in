# BF2 Round Replay (made by server/install.sh from server/Caddyfile.in; __SITE__ = the domain, or :80 without one)
__SITE__ {
	encode zstd gzip

	# the page, its version, its assets and the list of rounds are checked on every visit (an unchanged file: a short
	# "304 not modified", nothing downloaded again; a new version shows at the next reload); decoded rounds and demos
	# never change under their name
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /version.json Cache-Control "no-cache"
	header /data/rounds.json Cache-Control "no-cache"
	header /data/reprocess.json Cache-Control "no-cache"
	header /data/rounds/* Cache-Control "public, max-age=31536000, immutable"
	header /data/demos/* Cache-Control "public, max-age=31536000, immutable"
	header /data/heat/* Cache-Control "public, max-age=31536000, immutable"
	header /data/stats/* Cache-Control "no-cache"
	header /r/* Cache-Control "no-cache"
	header /p/* Cache-Control "no-cache"
	header /assets/* Cache-Control "no-cache"
	header /rss.xml Content-Type "application/rss+xml; charset=utf-8"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	# (v224) who may open what: while a part of the site is closed to guests (the admin page, "Users and access"),
	# admin.mjs keeps data/.access-gate, and every request but the login's and the admin page's is asked about first
	# (/admin/api/gate: the visitor's login and rights against the part of the site the path is) - a page he may not open
	# goes to /login, a file gets 401 / 403. An open site (no such file) asks nothing.
	@gate {
		not path /admin /admin/* /login /robots.txt
		file {
			root /srv/bf2replay/data
			try_files /.access-gate
		}
	}
	forward_auth @gate 127.0.0.1:8781 {
		uri /admin/api/gate
		header_up X-BF2R-Uri {http.request.orig_uri}
	}

	# link previews: /r/<round> and /p/<player> are small pages (data/share/r|p/*.html, written by ingest.mjs) with
	# the title and picture chat apps show under a link; they send the visitor on to the page
	@share path_regexp share ^/([rp])/([A-Za-z0-9_.-]+)$
	rewrite @share /data/share/{re.share.1}/{re.share.2}.html

	# pages for search engines (every round, player and map as plain HTML; the records), the RSS feed of new rounds, sitemap.xml and
	# robots.txt: data/www, written by ingest.mjs
	@www path /rounds /rounds/* /players /players/* /maps /maps/* /records /records/* /rss.xml /sitemap.xml /robots.txt
	handle @www {
		header Cache-Control "no-cache"
		root * /srv/bf2replay/data/www
		try_files {path} {path}/index.html
		file_server
	}
	# rounds.json (v166: a short line a round), decoded rounds (rounds/*.bfr), the demos themselves (demos/*.bf2demo), the
	# numbers over all rounds (stats/: players, maps, everyone - v165); the whole round list and every kill
	# (.rounds-full.json, .kills/ - v166) are for the server only, as all of data/.*
	handle_path /data/* {
		root * /srv/bf2replay/data
		@private path /logs/* /empty/* /bad/* /.*
		respond @private 404
		file_server
	}
	# the admin page (server/admin.mjs on 127.0.0.1:8781, behind a password: admin.mjs --set-password); (v224) the site's
	# login page
	handle /admin* {
		reverse_proxy 127.0.0.1:8781
	}
	handle /login {
		reverse_proxy 127.0.0.1:8781
	}
	# the site (from the repository's site/ folder)
	handle {
		root * /srv/bf2replay/site
		file_server
	}
	log {
		output file /var/log/caddy/bf2replay.log
	}
}

[Unit]
Description=BF2 Round Replay: decode every kept demo again and write the round list from scratch (started from the admin page)
After=network.target

[Service]
Type=oneshot
User=bf2replay
Group=bf2replay
Nice=10
EnvironmentFile=/etc/bf2replay.conf
ExecStart=/usr/bin/flock -w 7200 /srv/bf2replay/data/.ingest.lock /usr/bin/node /srv/bf2replay/repo/server/ingest.mjs --rebuild
TimeoutStartSec=24h

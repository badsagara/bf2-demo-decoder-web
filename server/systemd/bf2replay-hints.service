[Unit]
Description=BF2 Round Replay: the hints over every player's rounds (analyze.mjs --auto: the rounds in the site's page, several at once, then data/.admin/hints)
After=network.target

[Service]
Type=oneshot
User=bf2replay
Group=bf2replay
# (low priority: the site and the decoding of new demos go first; v248: several rounds at once - the admin page's
# Rounds at once, or BF2R_ANALYZE_JOBS in /etc/bf2replay.conf)
Nice=15
IOSchedulingClass=idle
CPUWeight=20
MemoryMax=80%
EnvironmentFile=-/etc/bf2replay.conf
WorkingDirectory=/srv/bf2replay
ExecStart=/usr/bin/node /srv/bf2replay/repo/server/analyze.mjs --auto
TimeoutStartSec=2h
# (stopped, it finishes the round it is on first)
KillMode=mixed
TimeoutStopSec=600

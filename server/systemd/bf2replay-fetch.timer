[Unit]
Description=BF2 Round Replay: download the day's new demos once a day (time: BF2R_FETCH_AT in /etc/bf2replay.conf)

[Timer]
# 05:30 by the server's clock (timedatectl); units.sh replaces it with BF2R_FETCH_AT when that is set.
# Persistent: a run missed while the server was off happens right after it starts.
OnCalendar=*-*-* 05:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target

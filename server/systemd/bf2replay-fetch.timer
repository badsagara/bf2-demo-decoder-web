[Unit]
Description=BF2 Round Replay: look for new demos - each demo page at its own time (fetch.mjs: the admin page, BF2R_FETCH_EVERY)

[Timer]
# (v210) every minute: fetch.mjs reads only the pages whose time is up - each its own on the admin page (Where demos come
# from), else BF2R_FETCH_EVERY minutes (10; 0 = once a day at BF2R_FETCH_AT). A run with nothing due ends at once and
# writes nothing. A demo is taken once it hasn't changed for 3 minutes - 30 s when the page lists the next round's
# after it; ingest decodes it as soon as it lands.
OnCalendar=*:*:00
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
